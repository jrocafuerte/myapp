# URL donde está publicado el micro frontend de Pago de servicios (mfe/pagos-servicios).
# Desarrollo: http://localhost:3001 (emulador Android: http://10.0.2.2:3001). Producción: siempre HTTPS.
EXPO_PUBLIC_PAGOS_MFE_URL=http://localhost:3001

# URL del JSON de configuración remota (mensajes, menús, mantenimiento). Ver remote-config/README.md.
# Vacía = textos de fábrica y sin mantenimiento.
EXPO_PUBLIC_REMOTE_CONFIG_URL=

# URL del BFF (salida ApiUrl de `cdk deploy`). Vacía = modo local (demo sin servidor).
# Desarrollo: http://localhost:4000 con `npm run bff:dev` (emulador Android: http://10.0.2.2:4000).
EXPO_PUBLIC_BFF_URL=
